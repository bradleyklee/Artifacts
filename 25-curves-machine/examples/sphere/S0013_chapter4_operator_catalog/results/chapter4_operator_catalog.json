      "coefficients_low_to_high": [
        "8*alpha",
        "-9*(1-3*alpha^2)",
        "-9*alpha*(1-alpha^2)"
      ]
    },
    "octahedral": {
      "coefficients_low_to_high": [
        "9*(6-5*alpha)",
        "-16*(12-22*alpha+9*alpha^2)",
        "16*(2-3*alpha)*(1-alpha)*(2-alpha)"
      ]
    },
    "icosahedral": {
      "coefficients_low_to_high": [
        "5*(5-21*alpha)",
        "4*(5+44*alpha-81*alpha^2)",
